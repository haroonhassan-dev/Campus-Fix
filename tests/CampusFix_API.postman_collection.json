        {
          "name": "GET /api/complaints - Server Unavailable Simulation Verification",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// In automated environments where the server is intentionally shut down,",
                  "// Postman/Newman encounters connection refusal (ECONNREFUSED).",
                  "// When testing against a gateway/proxy or mock 503 responder:",
                  "if (pm.response) {",
                  "    pm.test(\"Status code is 503 or 500 when server/store unavailable\", function () {",
                  "        pm.expect([500, 502, 503, 504]).to.include(pm.response.code);",
                  "    });",
                  "    pm.test(\"Error envelope returned\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData).to.have.property('error');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
